{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stock-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "secrets": {
    "required": ["AUTHDEEP_SERVICE_KEY", "AUTHDEEP_HMAC_SECRET", "RUN_SECRET"]
  },
  "vars": {
    "AUTHDEEP_BASE_URL": "https://roaa-alsham.authdeep.com",
    "AUTHDEEP_DIGEST_TO": "roaa.tur.123@gmail.com"
  },
  "routes": [
  { "pattern": "stock-worker.ralsham.com", "custom_domain": true }
]
}
